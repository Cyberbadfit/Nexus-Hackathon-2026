PORT=8080
NODE_ENV=development

# Use either https://YOUR_PROJECT_REF.supabase.co or its /rest/v1 endpoint.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_a_server_only_key

# Generate long, random values. Do not reuse the example text.
ENCRYPTION_KEY=replace_with_a_long_random_encryption_key
JWT_SECRET=replace_with_a_long_random_jwt_secret
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Add any separate frontend origins here. The deployed site can always call
# its own /api endpoint without being added.
ALLOWED_ORIGINS=http://localhost:8080
